{
  "name": "@fuzdev/fuz_css",
  "version": "0.66.0",
  "description": "semantic-first CSS framework and design system",
  "tagline": "CSS with more utility",
  "glyph": "🪴",
  "logo": "logo.svg",
  "logo_alt": "a fuzzy tuft of green moss",
  "license": "MIT",
  "homepage": "https://css.fuz.dev/",
  "repository": "https://github.com/fuzdev/fuz_css",
  "author": {
    "name": "Ryan Atkinson",
    "email": "mail@ryanatkn.com",
    "url": "https://www.ryanatkn.com/"
  },
  "bugs": "https://github.com/fuzdev/fuz_css/issues",
  "funding": "https://www.ryanatkn.com/funding",
  "scripts": {
    "start": "gro dev",
    "dev": "gro dev",
    "build": "gro build",
    "check": "gro check",
    "test": "gro test",
    "preview": "vite preview",
    "deploy": "gro deploy"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#routes/*": "./src/routes/*"
  },
  "engines": {
    "node": ">=24.14"
  },
  "peerDependencies": {
    "@fuzdev/blake3-wasm": "^0.2.0",
    "@fuzdev/fuz_util": ">=0.72.0",
    "@fuzdev/gro": ">=0.203.0",
    "@sveltejs/acorn-typescript": "^1",
    "@webref/css": "^8",
    "acorn-jsx": "^5",
    "svelte": "^5",
    "zimmerframe": "^1",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "@fuzdev/blake3-wasm": {
      "optional": true
    },
    "@fuzdev/gro": {
      "optional": true
    },
    "@sveltejs/acorn-typescript": {
      "optional": true
    },
    "@webref/css": {
      "optional": true
    },
    "acorn-jsx": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "zimmerframe": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-git": "^0.2.1",
    "@fuzdev/blake3-wasm": "^0.2.0",
    "@fuzdev/fuz_code": "^0.50.0",
    "@fuzdev/fuz_ui": "^0.212.0",
    "@fuzdev/fuz_util": "^0.72.0",
    "@fuzdev/gro": "^0.214.0",
    "@fuzdev/mdz": "^0.3.0",
    "@ryanatkn/eslint-config": "^0.12.2",
    "@sveltejs/acorn-typescript": "^1.0.9",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/estree": "^1.0.8",
    "@types/node": "^24.10.1",
    "@webref/css": "^8.1.3",
    "acorn-jsx": "^5.3.2",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.1",
    "esm-env": "^1.2.2",
    "jsdom": "^29.1.1",
    "magic-string": "^0.30.21",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-docinfo": "^0.8.0",
    "svelte2tsx": "^0.7.51",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.0",
    "zimmerframe": "^1.1.4",
    "zod": "^4.3.6"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/lib/**/*.ts",
    "!src/lib/**/*.test.*",
    "!dist/**/*.test.*"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.ts": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.css": {
      "default": "./dist/*.css"
    }
  }
